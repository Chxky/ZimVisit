# ZimVisit Environment Configuration
# Copy to .env and fill in values

# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=zimvisit
DB_PASSWORD=zimvisit_secret
DB_DATABASE=zimvisit

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Payment Providers
PAYNOW_INTEGRATION_KEY=
PAYNOW_MERCHANT_EMAIL=
PAYNOW_RETURN_URL=https://zimvisit.co.zw/payment/return
PAYNOW_RESULT_URL=https://api.zimvisit.co.zw/api/v1/payments/paynow-callback

ECOCASH_API_KEY=
ECOCASH_MERCHANT_ID=
ECOCASH_API_URL=https://api.ecocash.co.zw

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# GDS / Travel APIs
TRAVELPORT_CLIENT_ID=
TRAVELPORT_CLIENT_SECRET=
TRAVELPORT_ENDPOINT=https://api.travelport.com

AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_ENDPOINT=https://test.api.amadeus.com

# Government APIs
ZTA_API_KEY=
ZTA_API_ENDPOINT=https://api.zta.gov.zw
ZIMRA_API_KEY=
ZIMRA_API_ENDPOINT=https://api.zimra.gov.zw

# AI Service
AI_SERVICE_URL=http://ai-service:8000

# Tax & Levy Rates
TOURISM_LEVY_RATE=0.02
VAT_RATE=0.15
BSP_PLATFORM_FEE=0.03

# Redis (for caching & sessions)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@zimvisit.co.zw

# S3 / File Storage
S3_BUCKET=zimvisit-assets
S3_REGION=af-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
